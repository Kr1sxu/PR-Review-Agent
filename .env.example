# ============================================================
# PR-Review Agent 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

# MiMo 大模型接口配置
MIMO_API_URL=https://api.example.com/v1/chat/completions
MIMO_API_KEY=sk-your-mimo-api-key
MIMO_MODEL_NAME=mimo-xxx

# text-embedding-v4 向量接口配置
EMBEDDING_API_URL=https://api.example.com/v1/embeddings
EMBEDDING_API_KEY=sk-your-embedding-api-key

# 可选配置
# LOG_LEVEL=INFO
# OUTPUT_DIR=./output
